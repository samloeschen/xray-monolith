/**
 * @ Version: SCREEN SPACE SHADERS - UPDATE 21 (+ scaled-blur engine support)
 * @ Description: AO - Blur Phase
 * @ Modified time: 2025-04-17 03:11:45
 * @ Author: https://www.moddb.com/members/ascii1457
 * @ Mod: https://www.moddb.com/mods/stalker-anomaly/addons/screen-space-shaders
 *
 * scaled-blur engine change (xray-monolith fork): under SSFX_AO_SCALED_BLUR the AO blur
 * runs passes 1-3 in the scaled corner domain and upsamples on the final pass, sampling
 * depth guidance at full-screen UV. Identical at scale 1; stock without the define.
 */

#include "screenspace_common.h"
#include "settings_screenspace_AO.h"

uniform float4 blur_setup; // x: source scale | y: radius ramp | z: Buffer width | w: Buffer Height
uniform float4 ao_setup; // Res | Intensity | - | Radius

Texture2D ao_image;
//Texture2D s_motion_vectors;

float4 main(p_screen I) : SV_Target
{
#ifdef SSFX_AO_SCALED_BLUR
	// 1 in same-domain passes (full-res / final upsample); ao_setup.x inside the scaled corner.
	float corner = (blur_setup.x <= 1.0f) ? max(ao_setup.x, 1.0f) : 1.0f;
	// AO source is always corner-domain, so the bilateral depth guide steps
	// blur_offset * ao_setup.x in screen UV on every pass (incl. the final upsample).
	float guide_scale = max(ao_setup.x, 1.0f);
#else
	float corner = 1.0f;
	float guide_scale = 1.0f;
#endif

	float2 tc = I.tc0 / blur_setup.x;

	float2 tc2D = I.tc0.xy * corner;
	float2 Pos2D = I.hpos.xy * corner;

	float4 base_image = ao_image.SampleLevel(smp_linear, tc, 0);

	float4 blur = 0;

	float2 buffer_pixel_size = 1.0 / blur_setup.zw;

#ifdef SSFX_AO_SCALED_BLUR
	// Keep blur taps inside the corner region (mirror of the IL blur clamp)
	float2 tc_limit = (corner > 1.0f) ?
		float2(1.0f, 1.0f) / max(ao_setup.x, 1.0f) - buffer_pixel_size :
		float2(1.0f, 1.0f);
#endif

	float radius = 1.0f;

#ifndef USE_MSAA
	float Depth = s_position.Sample( smp_nofilter, tc2D ).z;
#else
	float Depth = s_position.Load( int3( Pos2D, 0 ), 0 ).z;
#endif

	float2 offset = float2(radius, radius) * clamp(base_image.r, ao_setup.z, 1.0f) * blur_setup.y; // 0.25 ~ 0.5 ~ 0.75f ~ 1.0f //
	float2 blur_tc = 0;
	float2 blur_offset = 0;

	float r = 2.0f;

	[unroll (G_SSDO_AO_BLUR_SAMPLES)]
	for (int i = 0; i < G_SSDO_AO_BLUR_SAMPLES; i++)
	{
		r += 1.0f / r;
		offset = mul(offset, pp_rotation_matrix);

		blur_offset = offset * (r - 1.0f) * buffer_pixel_size;
#ifdef SSFX_AO_SCALED_BLUR
		blur_tc = min(saturate(tc + blur_offset), tc_limit);
#else
		blur_tc = saturate(tc + blur_offset);
#endif

		float4 BlurSample = ao_image.SampleLevel(smp_linear, blur_tc, 0);

#ifndef USE_MSAA
		float SDepth = s_position.Sample( smp_nofilter, tc2D + blur_offset * guide_scale ).z;
#else
		float SDepth = s_position.Load( int3( Pos2D + blur_offset * guide_scale, 0 ), 0 ).z;
#endif

		blur.w += lerp(BlurSample.w, base_image.w, saturate(abs(Depth - SDepth) * 10.0f));

	}
	blur.w /= G_SSDO_AO_BLUR_SAMPLES;

	return float4(base_image.rgb, blur.w);
}
